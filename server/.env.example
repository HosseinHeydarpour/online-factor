# تنظیمات سرور
PORT=5000
NODE_ENV=development

# رشته اتصال به پایگاه‌داده مونگودی‌بی
# در لوکال: mongodb://127.0.0.1:27017/online_factor_db
# یا اطلس/سرور ابری: mongodb+srv://<username>:<password>@cluster0.mongodb.net/online_factor_db
MONGODB_URI=mongodb://127.0.0.1:27017/online_factor_db

# کلید امنیتی امضای توکن‌های ورود مدیر
JWT_SECRET=super_secret_jwt_key_cafe_factor_2026_change_in_production
JWT_EXPIRES_IN=30d

# نام کاربری و رمزعبور پیش‌فرض مدیر برای بار اول
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=1234
